{
    "name": "ai-toolset/tm",
    "description": "Task manager for the toolset",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ai-toolset/ai-lib": "dev-main",
        "symfony/console": "^7.0",
        "robmorgan/phinx": "^0.16",
        "php-mcp/server": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.6",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AiToolset\\Tm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiToolset\\Tm\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/tm",
        "bin/tm-mcp"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/mennozweistra/ai-lib"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=256M",
        "fix": "php-cs-fixer fix",
        "deptrac": "out=$(deptrac analyse --no-progress 2>&1); rc=$?; printf '%s\n' \"$out\"; printf '%s' \"$out\" | grep -q 'Syntax Error' && { echo 'deptrac: files failed to parse and were silently excluded from the graph'; exit 1; }; exit $rc",
        "rector": "rector process",
        "ci": [
            "@test",
            "@stan",
            "php-cs-fixer fix --dry-run --diff",
            "@deptrac",
            "rector process --dry-run"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
